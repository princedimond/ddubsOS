configuration {
  font: "monospace 11";
}

* {
  background:  #1e1e2e;
  foreground:  #cdd6f4;
  selected:    #89b4fa;
  border:      #45475a;
}

window {
  border:        1;
  padding:       8;
  width:         45%;
}

listview {
  lines:         15;
  columns:       1;
  spacing:       2;
}

element {
  padding:       2 4;
}

element-text {
  highlight:     bold;
}
